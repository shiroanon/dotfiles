desc:Stereo Rotator LPF
slider1:0<-180,180,1>Rotation
slider2:500<20,20000,1>Cutoff
slider3:0.7<0.1,10,0.1>Q

@init
lx1=lx2=ly1=ly2=rx1=rx2=ry1=ry2=0;

@sample
// Recalculate everything here since @slider is forbidden
ang = slider1 * 0.01745329;
c_c = cos(ang); 
s_c = sin(ang);

fx = (slider2 * 6.283185) / srate;
fs = sin(fx); 
fc = cos(fx); 
fa = fs / (2 * slider3);
fa0 = 1 + fa;

b0 = ((1 - fc) / 2) / fa0;
b1 = (1 - fc) / fa0;
b2 = ((1 - fc) / 2) / fa0;
ma1 = (-2 * fc) / fa0;
ma2 = (1 - fa) / fa0;

// Stereo Rotation
iL = spl0;
iR = spl1;
rL = iL * c_c - iR * s_c;
rR = iL * s_c + iR * c_c;

// LPF Left
oL = rL * b0 + lx1 * b1 + lx2 * b2 - ly1 * ma1 - ly2 * ma2;
lx2 = lx1; lx1 = rL; ly2 = ly1; ly1 = oL;

// LPF Right
oR = rR * b0 + rx1 * b1 + rx2 * b2 - ry1 * ma1 - ry2 * ma2;
rx2 = rx1; rx1 = rR; ry2 = ry1; ry1 = oR;

spl0 = oL;
spl1 = oR;