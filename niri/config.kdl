input {
	keyboard {
		numlock
	}
	touchpad {
		tap
		natural-scroll
		accel-speed 0.3
	}
	mouse
	trackpoint
}
cursor {
	xcursor-size 35
}
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
output "eDP-1" {
	// No explicit mode: the panel's only non-refresh-locked mode is the
	// preferred 1920x1080@60.008. The old "1920x1080@59.96" never existed
	// and was silently fuzzy-matched.
	scale 1
	position x=0 y=0
}
output "HDMI-A-2" {
    // Secondary external monitor
    mode "1920x1080@60.000" // Match exact resolution and refresh rate from niri msg outputs
    scale 1.0
    position x=1920 y=0      // Place to the right of eDP-1 (accounting for primary width)
    // transform "normal"    // Optional: use "90", "180", "270", or "flipped" if rotated
}
hotkey-overlay {
	skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%m-%d/%H-%M-%S.png"
include "shiro/environments.kdl"
include "shiro/binds.kdl"
include "shiro/windowrules.kdl"
include "shiro/startup.kdl"
include "shiro/animations.kdl"
include "shiro/layout.kdl"
