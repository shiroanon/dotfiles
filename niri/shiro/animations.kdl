animations {
    //off
	slowdown 0.65
	workspace-switch {
		spring damping-ratio=0.85 stiffness=1251 epsilon=0.00001
	}
	window-open {
		duration-ms 150
		curve "cubic-bezier" 0.05 0.7 0.1 1.0
	}
	window-close {
		duration-ms 100
		curve "ease-out-quad"
	}
	horizontal-view-movement {
		spring damping-ratio=0.8 stiffness=1351 epsilon=0.00001
	}
	window-movement {
		spring damping-ratio=0.75 stiffness=1000 epsilon=0.0001
	}
	window-resize {
		spring damping-ratio=0.8 stiffness=1801 epsilon=0.0002
	}
	config-notification-open-close {
		spring damping-ratio=0.75 stiffness=1800 epsilon=0.001
	}
	exit-confirmation-open-close {
		spring damping-ratio=0.75 stiffness=900 epsilon=0.01
	}
	overview-open-close {
		spring damping-ratio=0.7 stiffness=901 epsilon=0.0001
	}
}
