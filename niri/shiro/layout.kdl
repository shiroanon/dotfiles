layout {
	gaps 19
	center-focused-column "never"
	background-color "transparent"
	default-column-width {

		proportion 0.66667
	}

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#00000064"
    }
	preset-column-widths {
		proportion 0.33333
		proportion 0.5
		proportion 0.66667
		proportion 0.9
	}
	preset-window-heights {
		proportion 0.33333
		proportion 0.5
		proportion 0.66667
		proportion 1.0
	}
	focus-ring {
	    width 2
		active-color "#ebfffd"
		inactive-color "#948f99"
		urgent-color "#f2b8b5"
	}
	border {
	    //off
	    width 2
		active-color "#d0bcff"
		inactive-color "#948f99"
		urgent-color "#f2b8b5"

	}

	tab-indicator {
		active-color "#d0bcff"
		inactive-color "#948f99"
		urgent-color "#f2b8b5"
	}
	insert-hint {
		color "#d0bcff80"
	}
}
recent-windows {
	highlight {
		active-color "#4f378b"
		urgent-color "#f2b8b5"
	}
}
